---
import { getCategoriesList } from "@/utils/getArchive";
import { getBlogPosts } from "@/utils/getBlogPosts";
export async function getStaticPaths(): Promise<any> {
	const posts = await getBlogPosts();
	// 多篇文章共用同一分类是常态，去重后每个分类只生成一条路由；否则会产生与自身冲突的重复路由
	const categorySet = new Set<string>();
	posts.forEach((post: any) => categorySet.add(post.data.categories));
	return Array.from(categorySet).map((categories: string) => ({
		params: { categories },
		props: { categories },
	}));
}
// 获取分类下的文章列表（扁平为与首页一致的连续列表）
const { categories } = Astro.params;
const articleList = (await getCategoriesList(categories)).flatMap((group: any) => group.data);
// 页面 Info
import SITE_CONFIG from "@/config";
const { Description } = SITE_CONFIG;
// 公共 Layout
import Layout from "@/layouts/Layout/Layout.astro";
// 文章卡片组件（与首页列表一致的独立卡片）
import ArticleCard from "@/components/ArticleCard/ArticleCard.astro";
---

<Layout title={`分类 ${categories} 下的文章`} description={Description} activeNav="categories">
	<section class="article-list-main" style="padding-bottom: 0">
		<div class="article-list-card">
			{articleList.map((post: any) => <ArticleCard post={{ data: post }} readTime={post.readTime} />)}
		</div>
	</section>
</Layout>
