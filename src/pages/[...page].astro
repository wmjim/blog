---
import type { GetStaticPathsOptions } from "astro";
import { getBlogPosts } from "@/utils/getBlogPosts";
import moveTopToFirst from "@/utils/moveTopToFirst";
import readingTime from "reading-time";
export async function getStaticPaths(options: GetStaticPathsOptions) {
	const { paginate } = options;
	const posts = (await getBlogPosts()).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
	// 置顶文章功能
	moveTopToFirst(posts);
	// 隐藏的文章不显示
	return paginate(
		posts.filter(i => !i.data.hide),
		{ pageSize: 15 }
	);
}

const { page } = Astro.props;
const { data, ...page_data } = page;
// 页面 Info
import SITE_CONFIG from "@/config";
const { Description } = SITE_CONFIG;
// 博客列表组件
import ArticleCard from "@/components/ArticleCard/ArticleCard.astro";
// 公共 Layout
import Layout from "@/layouts/Layout/Layout.astro";
// 分页组件
import Pagination from "@/components/Pagination/Pagination.astro";
// page.currentPage 是数字，与 base 无关；url.current 含 base 会导致标题污染
const { currentPage } = page;
---

<Layout title={currentPage > 1 ? `第${currentPage}页文章` : ""} description={Description} showAside>
	<section class="article-list-main">
		<div class="article-list-card">
			<!-- 文章列表 -->
			{data.map((post, index) => <ArticleCard post={post} index={index} readTime={Math.ceil(readingTime(post.body || '').minutes) || 1} />)}
			<!-- 分页 -->
		</div>
		<Pagination data={page_data.url} />
	</section>
</Layout>
