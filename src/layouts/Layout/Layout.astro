---
const { title, keywords, description, pagecover, date, updated, activeNav, showAside = false } = Astro.props;
// 网站配置
import SITE_INFO from "@/config";
const { GoogleAds, Theme } = SITE_INFO;
// 站点报头文案（参考 nvie.com 的站点名 + 副标题）
const SITE_NAME = SITE_INFO.Title;
const SITE_SUBTITLE = SITE_INFO.Subtitle;
// 首页（无自身标题）用 h1 承载站点名，其余页面用 p，避免单页出现两个 h1
const MastheadTag = title ? "p" : "h1";
const { ad_Client, asideAD_Slot, articleAD_Slot } = GoogleAds;
// Head 依赖
import Head from "@/components/Head/Head.astro";
// 顶部 Header
import Header from "@/components/Header/Header.astro";
// Aside组件
import Aside from "@/components/Aside/Aside.astro";
// 底部 Footer
import Footer from "@/components/Footer/Footer.astro";
// 返回顶部
import BackTop from "@/components/BackTop/BackTop.astro";
// 手机端侧边栏
import MobileSidebar from "@/components/MobileSidebar/MobileSidebar.astro";
// A Modern CSS Reset
import "@/styles/Reset.less";
// 全局基础样式
import "@/styles/Base.less";
// Layout 样式
import "./Layout.less";
---

<html lang="zh-CN">
	<Head Title={title} Keywords={keywords} Description={description} PageCover={pagecover} Date={date} Updated={updated}>
		<!-- 谷歌广告JS加载项 -->
		{ad_Client && (asideAD_Slot || articleAD_Slot) && <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ad_Client}`} crossorigin="anonymous" />}
		<!-- 设置主题颜色 -->
		<Fragment
			set:html={`<style>:root {${Object.entries(Theme)
				.map(([key, value]) => `${key}:${value};`)
				.join("")}}</style>`}
		/>
	</Head>
	<body>
		<a class="vh-skip-link" href="#main-content">跳到主要内容</a>
		<MobileSidebar />
		<Header activeNav={activeNav} />
		<main class="main" id="main-content">
			<section class={showAside ? "main-inner" : "main-inner no-aside"}>
				<section class="main-inner-content">
					<!-- 站点报头：站点名 + 副标题 + 细线（参考 nvie.com 的页首排版） -->
					<header class="vh-masthead">
						<MastheadTag class="vh-masthead-title"><a href={import.meta.env.BASE_URL}>{SITE_NAME}</a></MastheadTag>
						<p class="vh-masthead-tagline">{SITE_SUBTITLE}</p>
					</header>
					<slot />
				</section>
				{showAside && <Aside />}
			</section>
			<BackTop />
		</main>
		<Footer />
		<script>
			import InitFn from "@/scripts/Init";
			// 全局初始化
			InitFn();
		</script>
	</body>
</html>
