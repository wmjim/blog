---
import "./TOC.less";
---

<!-- 顶部阅读进度条：整页滚动进度，fixed 独立于目录显隐（移动端 TOC 收起时仍可见） -->
<div class="vh-reading-progress" id="vh-reading-progress" aria-hidden="true"></div>

<nav class="vh-toc" id="vh-toc" aria-label="文章目录">
	<h3 class="vh-toc-title">目录</h3>
	<ul class="vh-toc-list" id="vh-toc-list">
		<!-- JS 动态生成 -->
	</ul>
</nav>


<script>
	import { initTOC } from "@/scripts/TOC";
	initTOC();
</script>
