---
import { getRelatedPosts } from "@/utils/getPostInfo";
import { fmtTime, fmtDateTime } from "@/utils/index";
const { currentId } = Astro.props;
const related = await getRelatedPosts(currentId, 3);
---

{related.length > 0 && (
	<nav class="vh-related" aria-label="相关文章">
		<h3>相关文章</h3>
		<div class="vh-related-list">
			{related.map(post => (
				<a class="vh-related-item" href={`${import.meta.env.BASE_URL}article/${post.id}`}>
					<span class="vh-related-title">{post.title}</span>
					<span class="vh-related-meta">
						<span class="vh-related-cat">{post.categories}</span>
						<time datetime={fmtDateTime(post.date)}>{fmtTime(post.date, "YYYY-MM-DD")}</time>
					</span>
				</a>
			))}
		</div>
	</nav>
)}

<style>
	// 相关文章 —— 沿用 nvie 的「» + 衬线标题 + 行内元信息」列表语言
	.vh-related {
		margin-top: 2rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--vh-border-color);
	}

	.vh-related h3 {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		margin: 0 0 0.75rem;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--vh-font-56);
	}

	.vh-related h3::after {
		content: '';
		flex: 1;
		height: 1px;
		background-color: var(--vh-border-color);
	}

	.vh-related-list {
		display: flex;
		flex-direction: column;
	}

	.vh-related-item {
		display: flex;
		align-items: baseline;
		gap: 0.625rem;
		padding: 0.5rem 0;
	}

	.vh-related-item::before {
		flex-shrink: 0;
		content: '»';
		color: var(--vh-font-28);
	}

	.vh-related-item:hover .vh-related-title {
		color: var(--vh-link-color-hover);
		text-decoration: underline;
		text-underline-offset: 0.2em;
		text-decoration-thickness: 1px;
	}

	.vh-related-title {
		flex: 1;
		min-width: 0;
		font-family: 'Noto Serif SC', 'Songti SC', 'STSong', 'SimSun', serif;
		font-size: 1.0625rem;
		font-weight: 600;
		line-height: 1.5;
		color: var(--vh-link-color);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.vh-related-meta {
		display: flex;
		align-items: baseline;
		gap: 0.625rem;
		font-size: 0.78rem;
		color: var(--vh-font-56);
		flex-shrink: 0;
	}

	.vh-related-cat {
		color: var(--vh-main-color);
		font-size: 0.78rem;
	}
</style>
