---
import { fmtTime } from "@/utils/index";
const { articleList } = Astro.props;
import "./Archive.less";
---

<section class="vh-archive-main vh-animation vh-animation-init">
	<div class="archive-list">
		{
			articleList.map((i: any) => (
				<div class="archive-list-item">
					<h2 class="archive-year-title">
						<span>{i.name}</span>
						<i class="line" />
					</h2>
					{i.data.map((_: any) => (
						<a href={`${import.meta.env.BASE_URL}article/${_.id}`}>
							<em class="date">{fmtTime(_.date, "MM-DD")}</em>
							<i class="dot" />
							<div class="entry">
								<span class="title vh-ellipsis">{_.title}</span>
								<span class="read-time">{_.readTime} min</span>
								{_.summary && <p class="summary vh-ellipsis">{_.summary}</p>}
							</div>
						</a>
					))}
				</div>
			))
		}
	</div>
</section>
