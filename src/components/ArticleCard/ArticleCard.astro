---
import { getDescription, fmtTime, fmtDateTime } from "@/utils/index";
const { post, readTime = 0 } = Astro.props;
const description = post.data.summary || getDescription(post);
import "./ArticleCard.less";
---

<article class={`vh-article-item vh-animation vh-animation-init${post.data.top ? " active" : ""}`}>
	<div class="vh-article-body">
		<a class="vh-article-cat" href={`${import.meta.env.BASE_URL}categories/${post.data.categories}`}>{post.data.categories}</a>
		<header>
			<h2 class="title"><a href={`${import.meta.env.BASE_URL}article/${post.data.id}`}>{post.data.title}</a></h2>
			<time datetime={fmtDateTime(post.data.date)}>{fmtTime(post.data.date, "YYYY-MM-DD")}</time>
			{readTime > 0 && <span class="vh-article-readtime">{readTime} 分钟</span>}
		</header>
		<p class="vh-article-excerpt vh-ellipsis line-2">{description}</p>
		<div class="vh-article-taglist">
			{post.data.tags.map((tag: string) => <a href={`${import.meta.env.BASE_URL}tags/${encodeURIComponent(tag)}`}>#{tag}</a>)}
		</div>
	</div>
</article>
