{
  "name": "blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "predev": "node script/generate-summary.mjs --soft",
    "prebuild": "node script/split-fonts.mjs && node script/generate-summary.mjs --soft",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "newpost": "node ./script/newpost.js",
    "summary": "node ./script/generate-summary.mjs",
    "test": "node --test script/*.test.mjs",
    "offdev": "astro preferences disable devToolbar",
    "ondev": "astro preferences enable devToolbar"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@swup/astro": "^1.7.0",
    "aplayer": "^1.10.1",
    "astro": "^7.2.10",
    "astro-compressor": "^1.1.2",
    "mermaid": "^11.15.0",
    "overlayscrollbars": "^2.12.0",
    "vanilla-lazyload": "^19.1.3",
    "vh-plugin": "^1.2.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@playform/compress": "^0.2.0",
    "@waline/client": "^3.6.0",
    "cheerio": "^1.1.2",
    "dayjs": "^1.11.18",
    "less": "^4.4.1",
    "mdast-util-to-string": "^4.0.0",
    "reading-time": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-sectionize": "^2.1.0",
    "subset-font": "^2.7.0",
    "typescript": "^7.0.2",
    "unist-util-visit": "^5.0.0"
  }
}
